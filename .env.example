# Aplicación
PORT=3000

# Base de datos (el puerto 5433 es el del host definido en docker-compose.yml)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=fluxa_user
DB_PASSWORD=fluxa_password
DB_NAME=fluxa_db
# Solo desarrollo: crea/actualiza tablas automáticamente. En producción: false.
DB_SYNCHRONIZE=true
# En producción: true (ejecuta migraciones al arrancar).
DB_MIGRATIONS_RUN=false

# Autenticación (JWT). OBLIGATORIO: la API no arranca sin JWT_SECRET.
# Cambia este valor por uno largo y aleatorio, p. ej.: openssl rand -base64 48
JWT_SECRET=CAMBIA_ESTE_SECRETO_por_uno_largo_y_aleatorio
# Duración del token: formato 15m, 1h, 7d o número de segundos.
JWT_EXPIRES_IN=1h

# pgAdmin
PGADMIN_EMAIL=admin@fluxa.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# Límite de peticiones (ventana en ms y máximo por ventana)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
