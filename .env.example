# Aplicación
PORT=3000

# Base de datos (el puerto 5433 es el del host definido en docker-compose.yml)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
# Solo desarrollo: crea/actualiza tablas automáticamente. En producción: false.
DB_SYNCHRONIZE=true
# En producción: true (ejecuta migraciones al arrancar).
DB_MIGRATIONS_RUN=false

# Autenticación (JWT). OBLIGATORIO: la API no arranca sin JWT_SECRET.
# Debe generarse uno aleatorio y largo, p. ej.: openssl rand -base64 48
JWT_SECRET=
# Duración del token: formato 15m, 1h, 7d o número de segundos.
JWT_EXPIRES_IN=1h

# pgAdmin
PGADMIN_EMAIL=admin@fluxa.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# Límite de peticiones (ventana en ms y máximo por ventana)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Entorno de ejecución. En producción: NODE_ENV=production (la API se niega a
# arrancar con DB_SYNCHRONIZE=true y CORS queda desactivado salvo CORS_ORIGIN).
NODE_ENV=development

# CORS: orígenes permitidos separados por comas (p. ej. https://app.fluxa.com,http://localhost:5173).
# Sin definir: abierto en desarrollo y desactivado en producción.
CORS_ORIGIN=
